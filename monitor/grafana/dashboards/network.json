{
  "uid": "network",
  "title": "Network",
  "tags": [
    "network"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Verdict (last 1 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max(1 - avg_over_time(probe_success{job=\"ping\",role=\"router\"}[1m]) > 0) * 0 + 3 or max(1 - avg_over_time(probe_success{job=\"ping\",role=\"internet\"}[1m]) > 0.2) * 0 + 2 or max(avg_over_time(probe_icmp_duration_seconds{job=\"ping\",phase=\"rtt\",role=\"internet\"}[1m]) > 0.15) * 0 + 1 or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Latency spike",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Signal / backhaul issue",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "Local issue (router / LAN)",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Router dropping = local (router/LAN/Wi-Fi). Router fine but internet >20% loss = ISP link (signal/backhaul). Internet >150 ms = latency spike."
    },
